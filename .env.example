# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
MODEL_ANALYSIS=claude-haiku-4-5
MODEL_DRAFT=claude-sonnet-5
MODEL_DIGEST=claude-opus-5

# --- Хранилище ---
DATABASE_URL=sqlite:///./reviews.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/reviews

# --- Общий рубильник публикации ---
PUBLISH_ENABLED=false

# --- Какие адаптеры магазинов использовать: mock | real ---
STORE_MODE=mock

# --- App Store Connect ---
APPSTORE_ENABLED=false
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXX.p8
APPSTORE_APP_ID=
# Пустое значение = все территории (дороже по запросам, но ничего не теряется)
APPSTORE_TERRITORIES=

# --- Google Play ---
GOOGLEPLAY_ENABLED=false
GOOGLEPLAY_SERVICE_ACCOUNT_PATH=./secrets/play-service-account.json
GOOGLEPLAY_PACKAGE_NAME=com.example.app

# --- Бренд ---
BRAND_PROFILE_PATH=./brand.json

# --- Расписание (минуты) ---
INGEST_INTERVAL_MINUTES=30
PIPELINE_INTERVAL_MINUTES=10
